{
  "name": "exaterm",
  "private": true,
  "version": "0.10.2",
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:frontend": "vitest run",
    "check:css": "node --test scripts/check-css-conventions.test.mjs && node scripts/check-css-conventions.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "format": "pnpm run format:frontend && pnpm run format:rust",
    "format:check": "pnpm run format:frontend:check && pnpm run format:rust:check",
    "format:frontend": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.mjs\" \"*.{html,json,ts,md}\" \".github/**/*.yml\" \".vscode/*.json\" \".agents/skills/**/*.{md,yaml,yml}\" \"docs/**/*.md\" \"src-tauri/*.json\"",
    "format:frontend:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.mjs\" \"*.{html,json,ts,md}\" \".github/**/*.yml\" \".vscode/*.json\" \".agents/skills/**/*.{md,yaml,yml}\" \"docs/**/*.md\" \"src-tauri/*.json\" && pnpm run check:css",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "i18next": "^26.7.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.8.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
