{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExaTerm",
  "version": "0.9.0",
  "identifier": "com.caribouhy.exaterm",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build && pnpm run prepare:sidecars",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ExaTerm",
        "width": 1280,
        "height": 800,
        "minWidth": 320,
        "minHeight": 240,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com https://openrouter.ai; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/exaterm-mcp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBOTgyQjI2OEE1ODhDOTAKUldTUWpGaUtKaXVZZXNtMDY3SHlhL1hxRExGMENIbE5odytJYm9qZWJNVDRCUnptSTg4WE11d0QK",
      "endpoints": ["https://github.com/caribouHY/exaterm/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
